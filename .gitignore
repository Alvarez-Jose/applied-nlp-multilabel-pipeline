__pycache__/
*.pyc
.vscode/
.claude/
review_output/

# DeBERTa weights — stored on HuggingFace Hub (jalva182/palestine-violence-deberta)
# Download automatically on first inference run; ~738 MB cached by transformers
modeling/saved_models/deberta_v3_multilabel/deberta_v3_best/model.safetensors
modeling/saved_models/deberta_v3_multilabel/deberta_v3_best/spm.model
modeling/saved_models/deberta_v3_multilabel/deberta_v3_best/training_args.bin

# Training checkpoints — intermediate artifacts, not needed for inference
modeling/saved_models/deberta_v3_multilabel/runs/

# Version checkpoints created by the Streamlit UI (local backups only)
modeling/backups/

# Lab workflow directories — track folder structure (.gitkeep) but not content
data/incoming/*
!data/incoming/.gitkeep
data/review_exports/*
!data/review_exports/.gitkeep
data/reviewed/*
!data/reviewed/.gitkeep
data/training/*
!data/training/.gitkeep

# === Added for public release: research data and derived weights stay private ===
# Raw and processed research data (private; not for public)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Training-data copy used by modeling (derived from private data)
modeling/training/data/

# Trained baseline model weights (derived from private data — could leak training rows via inference)
modeling/saved_models/baseline_*/*.joblib
modeling/saved_models/baseline_*/*.pkl

# Internal team docs that should not be public
docs/meeting_notes.md

# Sample incident row from research data (engineering scaffolding only)
data_pipeline/examples/incidents_sample.csv
