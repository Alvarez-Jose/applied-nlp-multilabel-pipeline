service_account.json
logs/*
!logs/.gitkeep
__pycache__/
*.pyc
.vscode/
.claude/
review_output/

# DeBERTa weights — stored on HuggingFace Hub (jalva182/palestine-violence-deberta)
# Download automatically on first inference run; ~738 MB cached by transformers
modeling/saved_models/deberta_v3_multilabel/deberta_v3_best/model.safetensors
modeling/saved_models/deberta_v3_multilabel/deberta_v3_best/spm.model
modeling/saved_models/deberta_v3_multilabel/deberta_v3_best/training_args.bin

# Training checkpoints — intermediate artifacts, not needed for inference
modeling/saved_models/deberta_v3_multilabel/runs/

# Version checkpoints created by the Streamlit UI (local backups only)
modeling/backups/

# Lab workflow directories — track folder structure (.gitkeep) but not content
data/incoming/*
!data/incoming/.gitkeep
data/review_exports/*
!data/review_exports/.gitkeep
data/reviewed/*
!data/reviewed/.gitkeep
data/training/*
!data/training/.gitkeep
